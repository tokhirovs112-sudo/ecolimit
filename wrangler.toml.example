name = "ecolimit"
compatibility_date = "2026-11-01"
pages_build_output_dir = "public"

[[d1_databases]]
binding = "DB"
database_name = "ecolimit-db"
# Cloudflare'da D1 baza yaratgandan keyin shu yerga uning ID sini qo'ying
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"
